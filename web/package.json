{
  "name": "@kerdly/web",
  "version": "0.1.0",
  "description": "Kerdly web SDK and kerdly.js snippet: first-party visitor ids, ad click and visit attribution, web-to-app links and identify, so you can see which ads pay back.",
  "license": "MIT",
  "author": "Kerdly",
  "homepage": "https://kerdly.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kerdly/kerdly-sdk.git",
    "directory": "web"
  },
  "keywords": [
    "kerdly",
    "attribution",
    "mobile-attribution",
    "first-party-attribution",
    "app-analytics",
    "subscription-analytics",
    "roas",
    "ltv",
    "ad-attribution",
    "web-to-app",
    "web-attribution",
    "utm",
    "click-id",
    "landing-page",
    "marketing-analytics",
    "web"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/kerdly.js"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./kerdly.js": "./dist/kerdly.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/Kerdly/kerdly-sdk/issues"
  }
}
